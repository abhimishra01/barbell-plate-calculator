---
// Barbell plate calculator UI. Logic lives in src/lib/plates.js (tested by npm test).
// A load page passes target and unit: the tool then starts from that load with default bar and plates.
interface Props { target?: number; unit?: 'lb' | 'kg'; }
const { target, unit } = Astro.props;
---
<section id="tool" aria-label="Plate calculator" data-target={target} data-unit={unit} class="rounded-2xl border border-line bg-card p-4 sm:p-6 sm:shadow-[6px_6px_0_0_var(--line)]">
  <noscript><p class="mb-4 rounded-xl bg-brand-soft p-3 text-sm">This calculator needs JavaScript. The tables below list common loads you can read without it.</p></noscript>
  <div class="flex flex-col gap-6 md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:items-start md:gap-8">

    <!-- Inputs. On a phone the weight comes first, then the result, then the settings. -->
    <div class="contents md:block md:space-y-6">
      <div class="order-1 space-y-5 md:order-none">
        <fieldset>
          <legend class="mb-2 text-sm font-semibold">Units</legend>
          <div class="grid grid-cols-2 gap-2" id="unit-group">
            <label class="seg"><input type="radio" name="unit" value="lb" class="peer sr-only" checked /><span class="seg-face">Pounds (lb)</span></label>
            <label class="seg"><input type="radio" name="unit" value="kg" class="peer sr-only" /><span class="seg-face">Kilograms (kg)</span></label>
          </div>
        </fieldset>

        <div>
          <label for="target" class="mb-2 block text-sm font-semibold">Target weight, bar included <span id="unit-label" class="font-normal text-muted">(lb)</span></label>
          <div class="flex items-stretch gap-2">
            <button type="button" id="dec" class="step" aria-label="Subtract one step from the target weight">&minus;</button>
            <input id="target" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="done" value="225" aria-describedby="result-status"
              class="h-14 min-w-0 flex-1 rounded-xl border border-edge bg-paper px-3 text-center font-mono text-3xl font-bold tabular-nums outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 aria-[invalid=true]:border-red-600" />
            <button type="button" id="inc" class="step" aria-label="Add one step to the target weight">+</button>
          </div>
          <div id="chips" class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Common weights"></div>
        </div>
      </div>

      <div class="order-3 space-y-5 md:order-none">
        <fieldset>
          <legend class="mb-2 text-sm font-semibold">Bar</legend>
          <div class="flex flex-wrap gap-2" id="bar-group"></div>
          <div id="custom-bar-wrap" class="mt-2 hidden items-center gap-2">
            <label for="custom-bar" class="text-sm text-muted">Bar weight</label>
            <input id="custom-bar" type="text" inputmode="decimal" autocomplete="off" value="25"
              class="h-12 w-28 rounded-xl border border-edge bg-paper px-3 text-center font-mono text-lg font-semibold tabular-nums outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 aria-[invalid=true]:border-red-600" />
            <span id="custom-bar-unit" class="text-sm text-muted">lb</span>
          </div>
        </fieldset>

        <fieldset>
          <legend class="mb-1 text-sm font-semibold">Plates you have</legend>
          <p class="mb-2 text-sm text-muted">Pick a set, or tap a plate to turn it off if your gym does not have it.</p>
          <div id="preset-group" class="mb-2 flex flex-wrap gap-2" role="group" aria-label="Plate sets"></div>
          <div id="plate-group" class="flex flex-wrap gap-2"></div>
        </fieldset>

        <div>
          <label class="flex min-h-12 cursor-pointer items-center gap-3 text-sm font-semibold">
            <input id="collars" type="checkbox" class="h-6 w-6 shrink-0 accent-[var(--brand)]" />
            Count collars (clips) in the total
          </label>
          <div id="collar-wrap" class="mt-1 hidden flex-wrap items-center gap-2 pl-9">
            <label for="collar-w" class="text-sm text-muted">Weight of one collar</label>
            <input id="collar-w" type="text" inputmode="decimal" autocomplete="off" value="1"
              class="h-12 w-24 rounded-xl border border-edge bg-paper px-3 text-center font-mono text-lg font-semibold tabular-nums outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 aria-[invalid=true]:border-red-600" />
            <span id="collar-unit" class="text-sm text-muted">lb</span>
            <span class="basis-full text-xs text-muted">A spring collar weighs about 1 lb. A competition collar weighs 2.5 kg.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Result -->
    <div class="order-2 min-w-0 md:order-none md:sticky md:top-20">
      <div class="min-h-[12rem] rounded-xl bg-brand-soft p-4" id="result-box">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-ink">Load on each side</p>
        <div id="side-list" class="mt-2 flex min-h-[3rem] flex-wrap items-center gap-2"></div>
        <p id="total-line" class="mt-2 min-h-[1.5rem] font-mono text-sm font-semibold tabular-nums"></p>
        <p id="result-status" role="status" aria-live="polite" class="mt-1 min-h-[3rem] text-base font-medium"></p>
        <p id="hint" class="min-h-[1.25rem] text-sm text-brand-ink"></p>
        <div id="alts" class="mt-2 grid min-h-[3.5rem] gap-2 sm:grid-cols-2"></div>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button type="button" id="copy-result" class="alt-btn">Copy result</button>
          <button type="button" id="copy-link" class="alt-btn">Copy link</button>
          <span id="copy-status" role="status" aria-live="polite" class="text-sm font-medium text-brand-ink"></span>
        </div>
      </div>

      <figure class="mt-4">
        <div class="h-[11.5rem] overflow-hidden rounded-xl border border-line bg-paper sm:h-[13rem]">
          <svg id="bar-svg" viewBox="0 0 640 240" preserveAspectRatio="xMidYMid meet" class="h-full w-full" role="img" aria-label="Barbell with plates"></svg>
        </div>
        <figcaption class="mt-1 text-xs text-muted">One side shown. Load the other side the same way. Put the heaviest plates on first, against the bar shoulder. The collar goes on last. Colors follow competition plates, so yours may look different.</figcaption>
      </figure>

      <div class="mt-5 flex flex-wrap items-end justify-between gap-2">
        <h2 class="text-sm font-semibold">Warm-up sets</h2>
        <div class="flex flex-wrap items-center gap-2">
          <label for="pct" class="text-sm text-muted">Percents</label>
          <input id="pct" type="text" inputmode="decimal" autocomplete="off" value="40, 60, 80" aria-describedby="pct-help"
            class="h-11 w-32 rounded-xl border border-edge bg-paper px-3 text-center font-mono text-base font-semibold tabular-nums outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 aria-[invalid=true]:border-red-600" />
          <button type="button" id="copy-warm" class="alt-btn">Copy warm-up</button>
        </div>
      </div>
      <p id="pct-help" class="sr-only">Up to five percents from 5 to 95, separated by commas.</p>
      <div class="mt-2 overflow-x-auto rounded-xl border border-line">
        <table class="w-full min-w-[20rem] text-left text-sm">
          <caption class="sr-only">Warm-up sets: the empty bar, then the chosen percents of the target weight, then the work set</caption>
          <thead class="bg-brand-soft text-xs uppercase tracking-wide text-brand-ink">
            <tr><th scope="col" class="px-3 py-2 font-semibold">Set</th><th scope="col" class="px-3 py-2 font-semibold">Weight</th><th scope="col" class="px-3 py-2 font-semibold">Each side</th></tr>
          </thead>
          <tbody id="warm" class="divide-y divide-line"></tbody>
        </table>
      </div>
      <p id="warm-note" class="mt-2 min-h-[1rem] text-xs text-muted"></p>
    </div>
  </div>
</section>

<style is:global>
  .seg-face { display:flex; min-height:3rem; align-items:center; justify-content:center; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); padding:.5rem .9rem; font-weight:600; font-size:.95rem; cursor:pointer; text-align:center; transition:background-color .12s,border-color .12s; user-select:none; }
  .seg-face:hover { border-color: var(--brand); }
  .peer:checked + .seg-face { background: var(--brand); border-color: var(--brand); color:#fff; }
  .peer:focus-visible + .seg-face { outline:2px solid var(--brand-ink); outline-offset:2px; }
  .step { width:3.5rem; flex:none; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); font-size:1.75rem; font-weight:600; line-height:1; cursor:pointer; }
  .step:hover { border-color: var(--brand); }
  .step:active { background: var(--brand-soft); }
  .chip { min-height:2.75rem; min-width:3.25rem; padding:.25rem .75rem; border-radius:999px; border:1px solid var(--edge); background:var(--paper); font-weight:600; font-size:.9rem; font-variant-numeric:tabular-nums; cursor:pointer; }
  .chip:hover { border-color: var(--brand); }
  .plate-pill { display:flex; min-height:3rem; align-items:center; gap:.5rem; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); padding:.35rem .8rem .35rem .6rem; font-weight:600; font-size:.95rem; cursor:pointer; user-select:none; font-variant-numeric:tabular-nums; }
  .plate-pill .dot { width:1.25rem; height:1.25rem; border-radius:999px; border:2px solid rgba(0,0,0,.35); flex:none; }
  .peer:not(:checked) + .plate-pill { opacity:.72; text-decoration:line-through; text-decoration-color: var(--muted); }
  .peer:not(:checked) + .plate-pill .dot { filter:grayscale(1); opacity:.5; }
  .peer:checked + .plate-pill { border-color: var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
  .peer:focus-visible + .plate-pill { outline:2px solid var(--brand-ink); outline-offset:2px; }
  .load-chip { display:inline-flex; align-items:center; gap:.5rem; border-radius:.75rem; background:var(--card); border:1px solid var(--line); padding:.4rem .75rem .4rem .5rem; font-weight:700; font-size:1.25rem; font-variant-numeric:tabular-nums; }
  .load-chip .dot { width:1.5rem; height:1.5rem; border-radius:999px; border:2px solid rgba(0,0,0,.35); flex:none; }
  .load-chip small { font-size:.85rem; font-weight:600; color:var(--muted); }
  .alt-btn { min-height:2.75rem; padding:.4rem .9rem; border-radius:.75rem; border:1px solid var(--brand); background:var(--card); font-weight:600; font-size:.95rem; color:var(--brand-ink); cursor:pointer; }
  .alt-btn:hover { background: var(--brand); color:#fff; }
  .alt-card { display:flex; flex-direction:column; align-items:flex-start; gap:.1rem; min-height:3.5rem; padding:.5rem .9rem; border-radius:.75rem; border:1px solid var(--brand); background:var(--card); color:var(--ink); text-align:left; cursor:pointer; font-variant-numeric:tabular-nums; }
  .alt-card strong { font-size:1.1rem; color:var(--brand-ink); }
  .alt-card span { font-size:.85rem; color:var(--muted); }
  .alt-card:hover { background: var(--brand-soft); }
  .chip.preset { transition:none; }
  :root[data-skin] .chip.preset[aria-pressed=true] { background: var(--brand); color:#fff; }
</style>
<script>
  import { PLATES, PRESETS, DEFAULT_PLATES, BARS, STEP, MAX_TARGET, solve, warmups, convertTarget, convertWeight, parseNumber, parsePercents, describe, fmt, exactHint, resultText, toQuery, fromQuery } from '../lib/plates.js';

  type Unit = 'lb' | 'kg';
  type Side = { w: number; n: number }[];
  const COLORS: Record<Unit, Record<string, [string, string]>> = {
    lb: { '45': ['#1d4ed8', '#fff'], '35': ['#facc15', '#1c1917'], '25': ['#16a34a', '#fff'], '10': ['#f1f1ee', '#1c1917'], '5': ['#dc2626', '#fff'], '2.5': ['#475569', '#fff'], '1.25': ['#a8a29e', '#1c1917'] },
    kg: { '25': ['#dc2626', '#fff'], '20': ['#1d4ed8', '#fff'], '15': ['#facc15', '#1c1917'], '10': ['#16a34a', '#fff'], '5': ['#f1f1ee', '#1c1917'], '2.5': ['#475569', '#fff'], '1.25': ['#a8a29e', '#1c1917'] },
  };
  // Plate diameters in mm (for the drawing), by weight.
  const DIAM: Record<Unit, Record<string, number>> = {
    lb: { '45': 450, '35': 400, '25': 340, '10': 260, '5': 205, '2.5': 170, '1.25': 140 },
    kg: { '25': 450, '20': 450, '15': 400, '10': 325, '5': 230, '2.5': 190, '1.25': 160 },
  };
  const QUICK: Record<Unit, number[]> = { lb: [95, 135, 185, 225, 275, 315, 405], kg: [60, 80, 100, 120, 140, 180] };
  const DEFAULT_CUSTOM: Record<Unit, number> = { lb: 25, kg: 10 };
  const DEFAULT_COLLAR: Record<Unit, number> = { lb: 1, kg: 2.5 };
  const KEY = 'plate-calc-v3';
  const DEFAULT_PCT = [40, 60, 80];

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (id: string, on: boolean) => { $(id).classList.toggle('hidden', !on); $(id).classList.toggle('flex', on); };
  const isWeight = (x: unknown): x is number => typeof x === 'number' && Number.isFinite(x) && x >= 0 && x <= MAX_TARGET;

  const state = {
    unit: 'lb' as Unit,
    target: 225,
    bar: { lb: '45', kg: '20' } as Record<Unit, string>,
    customBar: { ...DEFAULT_CUSTOM } as Record<Unit, number>,
    plates: { lb: [...DEFAULT_PLATES.lb], kg: [...DEFAULT_PLATES.kg] } as Record<Unit, number[]>,
    collars: false,
    collarW: { ...DEFAULT_COLLAR } as Record<Unit, number>,
    pct: [...DEFAULT_PCT],
  };
  const root = $('tool');
  const pageUnit = root.dataset.unit as Unit | undefined;
  const pageTarget = Number(root.dataset.target);

  // A load page starts clean: its own target, the default bar and the default plates. Saved settings load only on the home page.
  try {
    const saved = pageUnit ? null : JSON.parse(localStorage.getItem(KEY) || 'null');
    if (saved && typeof saved === 'object') {
      if (saved.unit === 'lb' || saved.unit === 'kg') state.unit = saved.unit;
      if (isWeight(saved.target) && saved.target > 0 && saved.target <= MAX_TARGET) state.target = saved.target;
      for (const u of ['lb', 'kg'] as Unit[]) {
        if (saved.bar && typeof saved.bar[u] === 'string' && (saved.bar[u] === 'custom' || (BARS[u] as number[]).map(String).includes(saved.bar[u]))) state.bar[u] = saved.bar[u];
        if (saved.customBar && isWeight(saved.customBar[u])) state.customBar[u] = saved.customBar[u];
        if (saved.plates && Array.isArray(saved.plates[u])) state.plates[u] = saved.plates[u].filter((w: unknown) => (PLATES[u] as number[]).includes(w as number));
        if (saved.collarW && isWeight(saved.collarW[u])) state.collarW[u] = saved.collarW[u];
      }
      state.collars = saved.collars === true;
      const pct = Array.isArray(saved.pct) ? parsePercents(saved.pct.join(',')) : null;
      if (pct) state.pct = pct;
    }
  } catch {}
  if (pageUnit && pageTarget > 0) { state.unit = pageUnit; state.target = pageTarget; }
  // A share link (?w=225&u=lb&bar=45&p=45,25,10,5,2.5) wins over everything else.
  const shared = fromQuery(location.search);
  if (shared.unit) state.unit = shared.unit;
  if (shared.target) state.target = shared.target;
  if (shared.bar !== undefined) {
    const u = state.unit;
    if ((BARS[u] as number[]).includes(shared.bar)) state.bar[u] = String(shared.bar);
    else { state.bar[u] = 'custom'; state.customBar[u] = shared.bar; }
  }
  if (shared.plates && shared.plates.length) state.plates[state.unit] = shared.plates;
  if (shared.collar) { state.collars = true; state.collarW[state.unit] = shared.collar; }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} };

  // The last number the person chose, so a unit round trip returns to it (135 lb, 60 kg, 135 lb).
  let anchor = { unit: state.unit, target: state.target };

  const barWeight = () => {
    const id = state.bar[state.unit];
    return id === 'custom' ? state.customBar[state.unit] : Number(id);
  };

  function buildStatic() {
    const u = state.unit;
    (document.querySelector(`input[name=unit][value=${u}]`) as HTMLInputElement).checked = true;
    $('unit-label').textContent = `(${u})`;
    $('custom-bar-unit').textContent = u;
    $('collar-unit').textContent = u;
    $<HTMLInputElement>('target').value = fmt(state.target);
    $<HTMLInputElement>('custom-bar').value = fmt(state.customBar[u]);
    $<HTMLInputElement>('collar-w').value = fmt(state.collarW[u]);
    $<HTMLInputElement>('collars').checked = state.collars;
    show('collar-wrap', state.collars);

    $('chips').innerHTML = QUICK[u].map((w) => `<button type="button" class="chip" data-w="${w}">${w}</button>`).join('');

    const bars = [...(BARS[u] as number[]).map((w) => ({ id: String(w), label: `${w} ${u}` })), { id: 'custom', label: 'Custom' }];
    $('bar-group').innerHTML = bars.map((b) =>
      `<label class="seg"><input type="radio" name="bar" value="${b.id}" class="peer sr-only"${b.id === state.bar[u] ? ' checked' : ''} /><span class="seg-face">${b.label}</span></label>`).join('');
    show('custom-bar-wrap', state.bar[u] === 'custom');

    $('preset-group').innerHTML = (PRESETS[u] as { id: string; label: string; plates: number[] }[]).map((p) =>
      `<button type="button" class="chip preset" data-preset="${p.id}" aria-pressed="false">${p.label}</button>`).join('');
    $<HTMLInputElement>('pct').value = state.pct.join(', ');

    $('plate-group').innerHTML = PLATES[u].map((w) => {
      const [bg] = COLORS[u][String(w)];
      return `<label><input type="checkbox" name="plate" value="${w}" class="peer sr-only"${state.plates[u].includes(w) ? ' checked' : ''} /><span class="plate-pill"><span class="dot" style="background:${bg}"></span>${fmt(w)} ${u}</span></label>`;
    }).join('');
  }

  // Drawing geometry, in SVG units. The viewBox is 240 high; the width shrinks to fit the plates.
  const CY = 120, MAXH = 216, START_X = 112, END_X = 600, GAP = 2, COLLAR_PX = 12, MAX_VIEW_W = 640, MIN_VIEW_W = 300;

  function drawBar(list: Side, collarOn: boolean) {
    const u = state.unit;
    const plates: number[] = [];
    list.forEach((p) => { for (let i = 0; i < p.n; i++) plates.push(p.w); });
    const big = u === 'lb' ? 35 : 20, mid = u === 'lb' ? 10 : 5;
    const baseW = (w: number) => (w >= big ? 30 : w >= mid ? 24 : 16);
    const collarPx = collarOn ? COLLAR_PX : 0;
    const avail = END_X - START_X - collarPx - 4;
    let widths = plates.map(baseW);
    const slots = widths.reduce((a, b) => a + b + GAP, 0);
    // Scale whole slots (plate plus gap) so the row never runs past the sleeve.
    if (slots > avail) { const k = avail / slots; widths = widths.map((w) => Math.max(5, (w + GAP) * k - GAP)); }
    const endX = START_X + widths.reduce((a, b) => a + b + GAP, 0);
    const viewW = Math.min(MAX_VIEW_W, Math.max(MIN_VIEW_W, endX + collarPx + 40));
    $('bar-svg').setAttribute('viewBox', `0 0 ${viewW.toFixed(0)} 240`);
    let x = START_X;
    let s = '';
    s += `<rect x="0" y="${CY - 7}" width="104" height="14" fill="#8c8c92"/>`;
    s += `<rect x="0" y="${CY - 7}" width="104" height="4" fill="#fff" opacity=".28"/>`;
    s += `<rect x="94" y="${CY - 24}" width="12" height="48" rx="3" fill="#6b6b72"/>`;
    s += `<rect x="106" y="${CY - 11}" width="${viewW - 106}" height="22" fill="#b4b4ba"/>`;
    s += `<rect x="106" y="${CY - 11}" width="${viewW - 106}" height="6" fill="#fff" opacity=".35"/>`;
    plates.forEach((pw, i) => {
      const key = fmt(pw);
      const [bg, fg] = COLORS[u][key];
      const h = (MAXH * DIAM[u][key]) / 450;
      const w = widths[i];
      s += `<rect x="${x.toFixed(1)}" y="${(CY - h / 2).toFixed(1)}" width="${w.toFixed(1)}" height="${h.toFixed(1)}" rx="4" fill="${bg}" stroke="rgba(0,0,0,.45)" stroke-width="1.5"/>`;
      if (w >= 15) {
        const fs = Math.min(15, w * 0.62);
        s += `<text x="${(x + w / 2).toFixed(1)}" y="${CY}" transform="rotate(-90 ${(x + w / 2).toFixed(1)} ${CY})" text-anchor="middle" dominant-baseline="central" font-family="ui-sans-serif,system-ui,sans-serif" font-size="${fs.toFixed(1)}" font-weight="700" fill="${fg}">${key}</text>`;
      }
      x += w + GAP;
    });
    if (collarOn) s += `<rect x="${(x + 1).toFixed(1)}" y="${CY - 18}" width="${COLLAR_PX - 2}" height="36" rx="3" fill="#2b2b30" stroke="rgba(255,255,255,.25)"/>`;
    $('bar-svg').innerHTML = s;
    const desc = list.length ? list.map((p) => `${p.n} of ${fmt(p.w)} ${u}`).join(', ') : 'no plates';
    $('bar-svg').setAttribute('aria-label', `Barbell with ${desc} on each side`);
  }

  let current: { text: string; r: any } | null = null;
  let warmText = '';
  const cell = (html: string, cls = '') => `<td class="px-3 py-2.5 tabular-nums ${cls}">${html}</td>`;
  const row = (label: string, weight: string, side: string) =>
    `<tr><th scope="row" class="px-3 py-2.5 font-semibold">${label}</th>${cell(weight, 'font-mono')}${cell(side)}</tr>`;

  function render() {
    const u = state.unit;
    const bar = barWeight();
    const collar = state.collars ? state.collarW[u] : 0;
    const plates = state.plates[u];
    const target = state.target;
    const status = $('result-status');
    const alts = $('alts');
    alts.innerHTML = '';
    $('hint').textContent = '';
    $('total-line').textContent = '';
    $('warm-note').textContent = '';
    current = null;
    document.querySelectorAll<HTMLElement>('.preset').forEach((b) => {
      const set = (PRESETS[u] as { id: string; plates: number[] }[]).find((p) => p.id === b.dataset.preset)!.plates;
      b.setAttribute('aria-pressed', String(set.length === plates.length && set.every((w) => plates.includes(w))));
    });

    // A blank or invalid bar or collar field must not hide behind an old value.
    const badField = !Number.isFinite(bar) || (state.collars && !Number.isFinite(collar));
    if (badField) {
      $('side-list').innerHTML = '<span class="text-lg font-semibold">Enter a weight</span>';
      status.textContent = !Number.isFinite(bar) ? 'Enter the bar weight to see the plates.' : 'Enter the collar weight, or turn collars off.';
      drawBar([], false);
      $('warm').innerHTML = [0, 1, 2, 3, 4].map(() => row('-', '-', '-')).join('');
      save();
      return;
    }

    const r: any = solve({ target, bar, collar, plates });
    const list: Side = r.list || [];
    const withCollars = collar ? ' and collars' : '';

    $('side-list').innerHTML = list.length
      ? list.map((p) => { const [bg] = COLORS[u][fmt(p.w)]; return `<span class="load-chip"><span class="dot" style="background:${bg}"></span>${fmt(p.w)}<small>&times; ${p.n}</small></span>`; }).join('')
      : `<span class="text-lg font-semibold">${r.status === 'empty' ? 'Enter a weight' : 'Empty bar'}</span>`;

    const onEach = list.length ? ` Load ${describe(list)} on each side.` : '';
    if (r.status === 'empty') status.textContent = 'Enter a weight above 0 to see the plates.';
    else if (r.status === 'bar') status.textContent = `${fmt(r.total)} ${u} is the bar${withCollars} alone. No plates needed.`;
    else if (r.status === 'below') status.textContent = `Your target is under the bar${withCollars} (${fmt(r.base)} ${u}). Use a lighter bar or a higher target.`;
    else if (r.status === 'exact') status.textContent = `Exact: ${fmt(r.total)} ${u} total with a ${fmt(bar)} ${u} bar${withCollars}.${onEach}`;
    else {
      status.textContent = plates.length
        ? `Cannot hit ${fmt(target)} ${u} exactly. Closest load is ${fmt(r.total)} ${u} with a ${fmt(bar)} ${u} bar${withCollars}.${onEach}`
        : 'Turn on at least one plate size to load the bar.';
      // Two cards: the nearest load under the target and the nearest over it. Tap one to use it.
      const mk = (x: { total: number; list: Side }, word: string) =>
        `<button type="button" class="alt-card" data-w="${x.total}"><strong>${fmt(x.total)} ${u}</strong><span>${fmt(Math.abs(x.total - target))} ${u} ${word}${x.list.length ? ': ' + describe(x.list) : ''}</span></button>`;
      if (plates.length) {
        if (r.lower.total > r.base) alts.innerHTML += mk(r.lower, 'under');
        alts.innerHTML += mk(r.upper, 'over');
        const hintPlate = exactHint({ target, bar, collar, plates, all: PLATES[u] });
        if (hintPlate !== null) $('hint').textContent = `Turn on the ${fmt(hintPlate)} ${u} plate to reach ${fmt(target)} ${u} exactly.`;
      }
    }
    if (r.status === 'exact' || r.status === 'closest' || r.status === 'bar') {
      const other: Unit = u === 'lb' ? 'kg' : 'lb';
      $('total-line').textContent = `${fmt(r.total)} ${u} = ${fmt(Math.round(convertWeight(r.total, u, other) * 10) / 10)} ${other}`;
    }
    current = { text: resultText(r, u, bar), r };
    if (list.length && r.plateCount > 10) status.textContent += ` That is ${r.plateCount} plates a side. Check they fit on the sleeve.`;

    drawBar(list, state.collars);

    // Warm-ups: empty bar, then 40/60/80 percent rounded to a practical jump, then the work set.
    let rounded = false;
    const warmRow = (label: string, x: any, ramp = true) => {
      if (x.status === 'empty') return row(label, '-', '-');
      if (x.status === 'bar' || x.status === 'below') return row(label, `${fmt(x.base)} ${u}`, 'Bar only');
      if (ramp && x.total !== x.want) rounded = true;
      return row(label, `${fmt(x.total)} ${u}`, x.list.map((p: { w: number; n: number }) => `${fmt(p.w)}${p.n > 1 ? `&times;${p.n}` : ''}`).join(' + '));
    };
    const ramp = warmups({ target, bar, collar, plates, percents: state.pct, step: STEP[u] }) as any[];
    warmText = [`Warm-up for ${fmt(target)} ${u} (${fmt(bar)} ${u} bar):`, `Empty bar: ${fmt(r.base)} ${u}`,
      ...ramp.map((x) => `${x.pct}%: ${x.list ? `${fmt(x.total)} ${u}, ${x.list.length ? describe(x.list) + ' per side' : 'bar only'}` : '-'}`),
      `Work set: ${fmt(r.total || 0)} ${u}${list.length ? ', ' + describe(list) + ' per side' : ''}`].join('\n');
    $('warm').innerHTML = [
      target > 0 ? row('Empty bar', `${fmt(r.base)} ${u}`, 'Bar only') : row('Empty bar', '-', '-'),
      ...ramp.map((x) => warmRow(`${x.pct}%`, x)),
      warmRow('Work set', r, false),
    ].join('');
    if (rounded) $('warm-note').textContent = 'Warm-ups are rounded to loads your plates can make.';
    save();
  }

  function setTarget(v: number) {
    if (!(v > 0)) return;
    state.target = Math.min(v, MAX_TARGET);
    anchor = { unit: state.unit, target: state.target };
    $<HTMLInputElement>('target').value = fmt(state.target);
    render();
  }
  const nudge = (dir: 1 | -1) => setTarget(Math.max(STEP[state.unit], (state.target || 0) + dir * STEP[state.unit]));
  const pickWeight = (e: Event) => {
    const b = (e.target as HTMLElement).closest('button[data-w]') as HTMLElement | null;
    if (b) setTarget(Number(b.dataset.w));
  };

  // Events
  const targetEl = $<HTMLInputElement>('target');
  targetEl.addEventListener('input', () => {
    const v = parseNumber(targetEl.value);
    targetEl.setAttribute('aria-invalid', String(targetEl.value.trim() !== '' && !(v > 0)));
    state.target = v > 0 ? Math.min(v, MAX_TARGET) : 0;
    if (v > MAX_TARGET) targetEl.value = fmt(MAX_TARGET);
    anchor = { unit: state.unit, target: state.target };
    render();
  });
  targetEl.addEventListener('blur', () => { if (state.target > 0) { targetEl.value = fmt(state.target); targetEl.removeAttribute('aria-invalid'); } });
  targetEl.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp') { e.preventDefault(); nudge(1); }
    if (e.key === 'ArrowDown') { e.preventDefault(); nudge(-1); }
  });
  $('inc').addEventListener('click', () => nudge(1));
  $('dec').addEventListener('click', () => nudge(-1));
  $('chips').addEventListener('click', pickWeight);
  $('alts').addEventListener('click', pickWeight);
  $('unit-group').addEventListener('change', (e) => {
    const to = (e.target as HTMLInputElement).value as Unit;
    if (to === state.unit) return;
    state.target = anchor.unit === to && anchor.target > 0 ? anchor.target : convertTarget(state.target, state.unit, to);
    state.unit = to;
    buildStatic(); render();
  });
  $('bar-group').addEventListener('change', (e) => {
    state.bar[state.unit] = (e.target as HTMLInputElement).value;
    show('custom-bar-wrap', state.bar[state.unit] === 'custom');
    render();
  });

  // Custom bar and collar fields: invalid text shows a message, and blur puts the used value back.
  function weightField(id: string, store: Record<Unit, number>, fallback: Record<Unit, number>) {
    const el = $<HTMLInputElement>(id);
    el.addEventListener('input', () => {
      const v = parseNumber(el.value);
      store[state.unit] = v <= MAX_TARGET ? v : NaN;
      el.setAttribute('aria-invalid', String(!Number.isFinite(store[state.unit])));
      render();
    });
    el.addEventListener('blur', () => {
      if (!Number.isFinite(store[state.unit])) { store[state.unit] = fallback[state.unit]; render(); }
      el.value = fmt(store[state.unit]);
      el.removeAttribute('aria-invalid');
    });
  }
  weightField('custom-bar', state.customBar, DEFAULT_CUSTOM);
  weightField('collar-w', state.collarW, DEFAULT_COLLAR);

  $('plate-group').addEventListener('change', () => {
    state.plates[state.unit] = Array.from(document.querySelectorAll<HTMLInputElement>('input[name=plate]:checked')).map((i) => Number(i.value));
    render();
  });
  $('collars').addEventListener('change', (e) => {
    state.collars = (e.target as HTMLInputElement).checked;
    show('collar-wrap', state.collars);
    render();
  });

  $('preset-group').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-preset]') as HTMLElement | null;
    if (!b) return;
    const set = (PRESETS[state.unit] as { id: string; plates: number[] }[]).find((p) => p.id === b.dataset.preset)!.plates;
    state.plates[state.unit] = [...set];
    document.querySelectorAll<HTMLInputElement>('input[name=plate]').forEach((i) => { i.checked = set.includes(Number(i.value)); });
    render();
  });

  const pctEl = $<HTMLInputElement>('pct');
  pctEl.addEventListener('input', () => {
    const v = parsePercents(pctEl.value);
    pctEl.setAttribute('aria-invalid', String(v === null));
    if (v) { state.pct = v; render(); }
  });
  pctEl.addEventListener('blur', () => { pctEl.value = state.pct.join(', '); pctEl.removeAttribute('aria-invalid'); });

  // Copy buttons. Falls back to a hidden textarea where the clipboard API is missing.
  let copyTimer = 0;
  async function copy(text: string, what: string) {
    if (!text) return;
    let ok = false;
    try { await navigator.clipboard.writeText(text); ok = true; } catch {
      const t = document.createElement('textarea');
      t.value = text; t.style.position = 'fixed'; t.style.opacity = '0';
      document.body.appendChild(t); t.select();
      try { ok = document.execCommand('copy'); } catch {}
      t.remove();
    }
    const el = $('copy-status');
    el.textContent = ok ? `${what} copied.` : 'Copy is not available in this browser.';
    clearTimeout(copyTimer);
    copyTimer = window.setTimeout(() => { el.textContent = ''; }, 2500);
  }
  $('copy-result').addEventListener('click', () => copy(current?.text || '', 'Result'));
  $('copy-warm').addEventListener('click', () => copy(warmText, 'Warm-up'));
  $('copy-link').addEventListener('click', () => {
    const u = state.unit;
    const link = `${location.origin}${location.pathname}?${toQuery({ target: state.target, unit: u, bar: barWeight(), plates: state.plates[u], collar: state.collars ? state.collarW[u] : 0 })}`;
    copy(link, 'Link');
  });

  buildStatic();
  render();
</script>
